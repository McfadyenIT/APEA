# APEA environment file — copy this file to ".env" (same folder) and fill in your key.
# APEA loads .env automatically on startup. Lines starting with # are ignored.
# Existing OS environment variables always take precedence over this file.

# Required to enable the agentic AI layer (self-repair, root-cause narrative,
# selector inference, Ask APEA). Without it, APEA runs deterministically.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — override the Claude model (default: claude-3-5-sonnet-latest)
# APEA_LLM_MODEL=claude-3-5-sonnet-latest

# Optional — turn AI pre-flight self-repair on by default (UI checkbox still works)
# APEA_AI_REPAIR=1

# Optional — seconds for the 1-user pre-flight dry run (default 18)
# APEA_PREFLIGHT_SECONDS=18
